# AINewsletter_v0.1 environment template
# Copy this file to backend/.env and add real API keys there.
# Never commit backend/.env or any real secret.
# Rules:
# - Uncomment an optional variable to override its Python default.
# - Restart the backend or Docker container after changing a value.
# - Boolean values accept 1/0 or true/false.
# - Docker Compose already overrides service URLs and persistent-data paths.

# -----------------------------------------------------------------------------
# Required and optional API keys

# Required for semantic embeddings when AI_UPDATES_EMBED_MODEL is text-embedding-3-small.
OPENAI_API_KEY=  # Editable here; read by server.py and ai_update_pipeline/config.py. No default.

# Optional Gemini key. When set, Gemini is used for news selection, Arabic writing,
# card rewriting, and AI tool discovery. OPENAI_API_KEY is still used for embeddings.
GEMINI_API_KEY=  # Also accepts Gemini_API_Key for compatibility.

# Required for live Exa news and course discovery.
EXA_API_KEY=  # Editable here; read by ai_update_pipeline/config.py. No default.

# Optional; required only for AI-related movie discovery through TMDb.
TMDB_API_KEY=  # Editable here; read by ai_update_pipeline/config.py. No default.

# -----------------------------------------------------------------------------
# Core server and UI behavior

# Docker Compose overrides HOST to 0.0.0.0. Local Python defaults to 127.0.0.1.
# HOST=127.0.0.1  # Editable here; read by server.py. Docker Compose overrides it.

# Keep 0 for normal live generation. Set 1 to serve only the current news JSON.
NEWS_JSON_ONLY_MODE=0  # Editable here; read by server.py.

# Hidden replacement cards retained by the server; 8 keeps 12 total news cards with the 4-card view.
NEWS_BACKUP_COUNT=8  # Editable here; read by server_store.py.

# Preserve a news_previous.json snapshot when saving new content.
# NEWS_PREVIOUS_SNAPSHOT_ENABLED=0  # Editable here; read by server_store.py.

# Visible-news diversity limits.
# NEWS_VISIBLE_MAX_PER_TOPIC_FAMILY=1  # Editable here; read by server_items.py.
# NEWS_VISIBLE_MAX_PER_COMPANY=2  # Editable here; read by server_items.py.

# Generator timing and route controls.
# GENERATOR_TIMEOUT=600  # Editable here; read by server.py.
# AUTO_FETCH_COOLDOWN=300  # Editable here; read by server.py.
# USE_AI_UPDATES_PIPELINE_FOR_GENERATE=1  # Editable here; read by server.py.
# SERVER_TRACE_HTTP=1  # Editable here; read by server.py.

# -----------------------------------------------------------------------------
# Single-card replacement

# Target time in seconds. The Python default is 45; this project uses 90.
SINGLE_REFILL_SECONDS=90  # Editable here; read by server_refill.py.

# Supporting-card candidate target and optional fast mode.
# SINGLE_REFILL_SUPPORTING_TARGET=2  # Editable here; read by server_refill.py.
# SINGLE_REFILL_FAST_MODE=0  # Editable here; read by server_refill.py.
# USE_AI_UPDATES_PIPELINE_FOR_SINGLE_REFILL=1  # Editable here; read by server_refill.py.

# -----------------------------------------------------------------------------
# OpenAI models and output shape

# Optional OpenAI model kept for legacy/manual paths; normal generation is Gemini-only.
AI_UPDATES_OPENAI_MODEL=gpt-5.2  # Editable here; default is defined in ai_update_pipeline/config.py.

# Gemini-only generation should use Flash models that are available on free tier.
AI_UPDATES_MODEL_PROVIDER=gemini
GEMINI_NEWS_MODEL=gemini-2.5-flash
GEMINI_REWRITE_MODEL=gemini-2.5-flash
GEMINI_FLASH_MODEL=gemini-2.5-flash
GEMINI_DAILY_REQUEST_BUDGET=18
GEMINI_FULL_RUN_REQUEST_BUDGET=6
GEMINI_MIN_SECONDS_BETWEEN_CALLS=6
GEMINI_STOP_ON_QUOTA=1

# Lightweight OpenAI rewrite fallback used only when GEMINI_API_KEY is not set.
# OPENAI_REWRITE_MODEL=gpt-4o-mini  # Editable here; read by server.py.

# Current level-balanced UI displays 4 news cards, 2 courses, and 1 movie.
# The full generated news bank remains 12 cards: 4 visible + 8 backup/bank cards.
# AI_UPDATES_VISIBLE_COUNT=4  # Editable here; default is defined in ai_update_pipeline/config.py.
# AI_UPDATES_BACKUP_COUNT=8  # Editable here; default is defined in ai_update_pipeline/config.py.
# AI_UPDATES_COURSES_VISIBLE_COUNT=2  # Editable here; default is defined in ai_update_pipeline/config.py.
# AI_UPDATES_MOVIES_VISIBLE_COUNT=1  # Editable here; default is defined in ai_update_pipeline/config.py.
# AI_UPDATES_SAVE_BACKUP_FROM_SELECTION=1  # Editable here; default is defined in ai_update_pipeline/config.py.

# Final selection limits.
# News freshness window: default is 7 days / last week. Uncomment to override it.
# AI_UPDATES_LOOKBACK_DAYS=7  # Editable here; default is defined in ai_update_pipeline/config.py.
# AI_UPDATES_OUTPUT_LIMIT=12  # Editable here; default is defined in ai_update_pipeline/config.py.
# AI_UPDATES_MIN_NEWS_SAVE_COUNT=6  # Editable here; minimum saved after 2 cycles; target still remains 12.
# AI_UPDATES_SINGLE_OUTPUT_LIMIT=5  # Editable here; default is defined in ai_update_pipeline/config.py.
# AI_UPDATES_SCAN_POOL_LIMIT=120  # Editable here; default is defined in ai_update_pipeline/config.py.
# AI_UPDATES_GPT_SHORTLIST_LIMIT=60  # Editable here; default is defined in ai_update_pipeline/config.py.
# AI_UPDATES_GPT_COMPACT_LIMIT=60  # Editable here; default is defined in ai_update_pipeline/config.py.
# AI_UPDATES_SINGLE_GPT_COMPACT_LIMIT=36  # Editable here; default is defined in ai_update_pipeline/config.py.

# Write news.json when running the pipeline directly rather than through server.py.
# AI_UPDATES_WRITE_NEWS_JSON=0  # Editable here; read by ai_update_pipeline/pipeline.py.

# -----------------------------------------------------------------------------
# SearXNG search

# SearXNG is required. Docker Compose sets this to http://searxng:8080.
# Uncomment only when the backend runs locally outside Docker.
# AI_UPDATES_SEARXNG_URL=http://localhost:8080  # Editable here; read by ai_update_pipeline/config.py. Docker overrides it.

# Legacy aliases accepted by config.py; prefer AI_UPDATES_SEARXNG_URL.
# SEARXNG_URL=http://localhost:8080  # Editable here; legacy alias read by ai_update_pipeline/config.py.
# SEARXNG_BASE_URL=http://localhost:8080  # Editable here; legacy alias read by ai_update_pipeline/config.py.

# Full-generation SearXNG limits.
# AI_UPDATES_SEARXNG_QUERY_LIMIT=40  # Editable here; default is defined in ai_update_pipeline/config.py.
# AI_UPDATES_SEARXNG_RESULTS_PER_QUERY=8  # Editable here; default is defined in ai_update_pipeline/config.py.
# AI_UPDATES_SEARXNG_TIMEOUT=12  # Editable here; default is defined in ai_update_pipeline/config.py.
# AI_UPDATES_SEARXNG_MAX_WORKERS=3  # Editable here; default is defined in ai_update_pipeline/config.py.
# SearXNG source freshness: default is week so search aligns with the 7-day news window.
# AI_UPDATES_SEARXNG_TIME_RANGE=week  # Editable here; default is defined in ai_update_pipeline/config.py.
# AI_UPDATES_SEARXNG_CATEGORIES=news,it,general  # Editable here; default is defined in ai_update_pipeline/config.py.

# -----------------------------------------------------------------------------
# Exa search

# Full-generation Exa limits and retry behavior.
# AI_UPDATES_EXA_QUERY_LIMIT=28  # Editable here; default is defined in ai_update_pipeline/config.py.
# AI_UPDATES_EXA_RESULTS_PER_QUERY=5  # Editable here; default is defined in ai_update_pipeline/config.py.
# AI_UPDATES_EXA_TIMEOUT=15  # Editable here; default is defined in ai_update_pipeline/config.py.
# AI_UPDATES_EXA_MAX_WORKERS=6  # Editable here; default is defined in ai_update_pipeline/config.py.
# AI_UPDATES_EXA_RETRIES=2  # Editable here; default is defined in ai_update_pipeline/config.py.
# AI_UPDATES_EXA_RETRY_BACKOFF_SECONDS=2  # Editable here; default is defined in ai_update_pipeline/config.py.

# Single-card search limits shared across Exa and SearXNG.
# AI_UPDATES_SINGLE_EXA_QUERY_LIMIT=6  # Editable here; default is defined in ai_update_pipeline/config.py.
# AI_UPDATES_SINGLE_SEARXNG_QUERY_LIMIT=10  # Editable here; default is defined in ai_update_pipeline/config.py.
# AI_UPDATES_SINGLE_RESULTS_PER_QUERY=5  # Editable here; default is defined in ai_update_pipeline/config.py.
# AI_UPDATES_SINGLE_EXA_RESULTS_PER_QUERY=5  # Editable here; default is defined in ai_update_pipeline/config.py.
# AI_UPDATES_SINGLE_TIMEOUT=16  # Editable here; default is defined in ai_update_pipeline/config.py.

# -----------------------------------------------------------------------------
# Monthly AI-tool discovery and cache maintenance

# AI_UPDATES_TOOL_CACHE_REFRESH_DAYS=30  # Editable here; default is defined in ai_update_pipeline/config.py.
# AI_UPDATES_TOOL_CACHE_MAX_RECORDS=120  # Editable here; default is defined in ai_update_pipeline/config.py.
# AI_UPDATES_TOOL_DISCOVERY_ENABLED=1  # Editable here; default is defined in ai_update_pipeline/config.py.
# AI_UPDATES_TOOL_DISCOVERY_MODEL=gpt-4o-mini  # OpenAI fallback only when GEMINI_API_KEY is not set.
# AI_UPDATES_TOOL_DISCOVERY_RESULTS=6  # Editable here; default is defined in ai_update_pipeline/config.py.
# AI_UPDATES_TOOL_SITE_DISCOVERY_LIMIT=24  # Editable here; read by ai_update_pipeline/fetchers.py.
# AI_UPDATES_TOOL_QUERY_ROTATION_POOL=48  # Editable here; read by ai_update_pipeline/fetchers.py.

# -----------------------------------------------------------------------------
# Courses and movies

# Supporting-content controls.
# AI_UPDATES_REFRESH_SUPPORTING_CONTENT=1  # Editable here; default is defined in ai_update_pipeline/config.py.
# AI_UPDATES_SUPPORTING_CONTENT_PREFETCH=1  # Editable here; default is defined in ai_update_pipeline/config.py.
# AI_UPDATES_SUPPORTING_COURSE_FETCH_POOL=24  # Editable here; default is defined in ai_update_pipeline/config.py.
# AI_UPDATES_SUPPORTING_MOVIE_FETCH_POOL=40  # Editable here; default is defined in ai_update_pipeline/config.py.
# AI_UPDATES_SINGLE_COURSE_FETCH_POOL=14  # Editable here; read by ai_update_pipeline/pipeline.py.
# AI_UPDATES_SINGLE_MOVIE_FETCH_POOL=28  # Editable here; read by ai_update_pipeline/pipeline.py.

# Leave the course query unset to use the maintained query bank in config.py.
# If overriding the date, use YYYY-MM-DD. When unset, code uses January 1 of
# the current year automatically; no annual edit is required.
# AI_UPDATES_COURSE_QUERY=  # Editable here; read by ai_update_pipeline/config.py.
# AI_UPDATES_COURSE_QUERY_VARIANTS=  # Editable here; read by ai_update_pipeline/config.py.
# AI_UPDATES_COURSE_START_PUBLISHED_DATE=YYYY-MM-DD  # Editable here; dynamic default is defined in ai_update_pipeline/config.py.
# AI_UPDATES_COURSE_NUM_RESULTS=10  # Editable here; default is defined in ai_update_pipeline/config.py.
# AI_UPDATES_COURSE_EXA_TYPE=neural  # Editable here; default is defined in ai_update_pipeline/config.py.
# AI_UPDATES_COURSE_EXA_QUERY_LIMIT=6  # Editable here; default is defined in ai_update_pipeline/config.py.
# AI_UPDATES_COURSE_EXA_RESULTS_PER_QUERY=10  # Editable here; default is defined in ai_update_pipeline/config.py.

# Rotate TMDb discovery pages to avoid returning the same movies every run.
# AI_UPDATES_MOVIE_ROTATION_MAX_PAGE=6  # Editable here; read by ai_update_pipeline/fetchers.py.

# -----------------------------------------------------------------------------
# Qdrant semantic memory and duplicate detection

# AI_UPDATES_MEMORY_ENABLED=1  # Editable here; default is defined in ai_update_pipeline/config.py.
# AI_UPDATES_SEMANTIC_MEMORY_ENABLED=1  # Editable here; default is defined in ai_update_pipeline/config.py.
# AI_UPDATES_SEMANTIC_MAX_CHECK=32  # Editable here; default is defined in ai_update_pipeline/config.py.
# AI_UPDATES_SINGLE_SEMANTIC_MAX_CHECK=24  # Editable here; default is defined in ai_update_pipeline/config.py.
# AI_UPDATES_MEMORY_EXACT_LIMIT=3000  # Editable here; default is defined in ai_update_pipeline/config.py.
# AI_UPDATES_EMBED_MODEL=text-embedding-3-small  # Editable here; default is defined in ai_update_pipeline/config.py.
# AI_UPDATES_EMBED_INPUT_LIMIT=1200  # Editable here; default is defined in ai_update_pipeline/config.py.
# AI_UPDATES_EMBED_SIZE=1536  # Editable here; default is defined in ai_update_pipeline/config.py.
# AI_UPDATES_QDRANT_COLLECTION=content_memory  # Editable here; default is defined in ai_update_pipeline/config.py.
# AI_UPDATES_SEMANTIC_DUPLICATE_SCORE=0.925  # Editable here; default is defined in ai_update_pipeline/config.py.
# AI_UPDATES_SAME_RUN_SEMANTIC_SCORE=0.90  # Editable here; default is defined in ai_update_pipeline/config.py.
# AI_UPDATES_REJECTED_DUPLICATE_SCORE=0.89  # Editable here; default is defined in ai_update_pipeline/config.py.

# -----------------------------------------------------------------------------
# Structured run logging and diagnostics

# Set AI_UPDATES_RUN_LOG_ENABLED=0 to stop creating ai_updates_run.jsonl.
# AI_UPDATES_RUN_LOG_ENABLED=1  # Editable here; read by ai_update_pipeline/observability.py.
# AI_UPDATES_RUN_LOG_STDOUT=1  # Editable here; read by ai_update_pipeline/observability.py.
# AI_UPDATES_RUN_LOG_FILE=backend/logs/ai_updates_run.jsonl  # Editable here; read by ai_update_pipeline/observability.py.

# Docker Compose stores the run report under /app/data/news/diagnostics.
# AI_UPDATES_RUN_REPORT_PATH=  # Editable here; read by server.py and ai_update_pipeline/config.py. Docker overrides it.
# MODEL_USAGE_SUMMARY_PATH=  # Operational model/quota state; Docker stores it under /app/data/news/runtime.

# -----------------------------------------------------------------------------
# Background generation daemon

# Disabled by default; the UI Generate button runs the pipeline manually.
# AI_UPDATES_DAEMON_ENABLED=0  # Editable here; default is defined in ai_update_pipeline/config.py.
# AI_UPDATES_INTERVAL=3600  # Editable here; default is defined in ai_update_pipeline/config.py.

# -----------------------------------------------------------------------------
# PDF export and PDF import

# PDF export profile and optional rendering controls.
# PDF_EXPORT_PROFILE=whatsapp  # Editable here; read by pdf_export.py.
# PDF_EXPORT_SCALE=  # Editable here; read by pdf_export.py.
# PDF_EXPORT_WHATSAPP_RASTER_SCALE=2.0  # Editable here; read by pdf_export.py.
# PDF_EXPORT_WHATSAPP_SCALE=2.0  # Editable here; legacy alias read by pdf_export.py.
# PDF_EXPORT_WHATSAPP_JPEG_QUALITY=95  # Editable here; read by pdf_export.py.
# PDF_EXPORT_WHATSAPP_MAX_MB=10  # Editable here; read by pdf_export.py.

# Local defaults are backend/logs and backend/pdf_versions.
# PDF_IMPORT_DEBUG_DIR=  # Editable here; read by server_versions.py.
# PDF_VERSION_FILES_DIR=  # Editable here; read by server_versions.py.

# -----------------------------------------------------------------------------
# Version database, backups, and generated JSON paths

# Newsletter runtime data defaults to data/news/runtime and diagnostic reports
# default to data/news/diagnostics. Docker Compose uses the same separation.
# VERSIONS_DB_PATH=  # Editable here; read by server_versions.py. Docker overrides it.
# VERSIONS_BACKUP_DIR=  # Editable here; read by server_versions.py. Docker overrides it.
# NEWS_JSON_PATH=  # Editable here; read by server_store.py and ai_update_pipeline/config.py. Docker overrides it.
# PREVIOUS_NEWS_JSON_PATH=  # Editable here; read by server_store.py. Docker overrides it.

# -----------------------------------------------------------------------------
# Postgres backups: continuous WAL archiving + pgBackRest, repository target
# is the self-hosted MinIO service (docker/compose/minio.yml). See
# docs/MAINTENANCE.md for restore instructions.
# MINIO_ROOT_USER=ainewsletter_minio  # Editable here; used by minio.yml and read natively by pgbackrest as the S3 key.
# MINIO_ROOT_PASSWORD=ainewsletter_minio_local  # Change this for anything beyond local dev.
# PGBACKREST_REPO1_S3_KEY=  # Defaults to MINIO_ROOT_USER. Set separately only if using a scoped MinIO user instead of root.
# PGBACKREST_REPO1_S3_KEY_SECRET=  # Defaults to MINIO_ROOT_PASSWORD.
# PGBACKREST_CRON_INCR=0 2 * * *  # Daily incremental backup schedule.
# PGBACKREST_CRON_DIFF=0 2 * * 0  # Weekly differential backup schedule (Sundays).
# PGBACKREST_CRON_FULL=0 2 1 * *  # Monthly full backup schedule (1st of month); repo1-retention-full=3 keeps ~90 days.
