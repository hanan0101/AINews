# Optional focused overrides for the AI update pipeline.
# Copy to backend/.env.ai_updates only if you need pipeline-specific overrides.
#
# Important: backend/.env.ai_updates overrides backend/.env.
# Leave values commented unless you really want to override them.
# Do not put blank API keys here, because blank values can disable working keys.

# Optional local SearXNG endpoint.
# AI_UPDATES_SEARXNG_URL=http://localhost:8080

# Output shape. Current UI expects 6 news, 2 courses, and 1 movie.
# AI_UPDATES_VISIBLE_COUNT=6
# AI_UPDATES_BACKUP_COUNT=6
# AI_UPDATES_COURSES_VISIBLE_COUNT=2
# AI_UPDATES_MOVIES_VISIBLE_COUNT=1
# AI_UPDATES_SAVE_BACKUP_FROM_SELECTION=1

# Time window and final output limits.
# AI_UPDATES_LOOKBACK_DAYS=14
# AI_UPDATES_OUTPUT_LIMIT=12
# AI_UPDATES_SINGLE_OUTPUT_LIMIT=5

# Large-scan and GPT payload controls.
# AI_UPDATES_SCAN_POOL_LIMIT=120
# AI_UPDATES_GPT_SHORTLIST_LIMIT=60
# AI_UPDATES_GPT_COMPACT_LIMIT=60
# AI_UPDATES_SINGLE_GPT_COMPACT_LIMIT=24

# Monthly tool-cache maintenance.
# AI_UPDATES_TOOL_CACHE_REFRESH_DAYS=30
# AI_UPDATES_TOOL_CACHE_MAX_RECORDS=120
# AI_UPDATES_TOOL_DISCOVERY_ENABLED=1
# AI_UPDATES_TOOL_DISCOVERY_MODEL=gpt-4o-mini
# AI_UPDATES_TOOL_DISCOVERY_RESULTS=6

# Full fetch limits.
# AI_UPDATES_EXA_QUERY_LIMIT=40
# AI_UPDATES_EXA_RESULTS_PER_QUERY=5
# AI_UPDATES_EXA_TIMEOUT=10
# AI_UPDATES_SEARXNG_QUERY_LIMIT=40
# AI_UPDATES_SEARXNG_RESULTS_PER_QUERY=8
# AI_UPDATES_SEARXNG_TIMEOUT=12
# AI_UPDATES_SEARXNG_TIME_RANGE=month
# AI_UPDATES_SEARXNG_CATEGORIES=news,it,general

# Single-card replacement limits.
# AI_UPDATES_SINGLE_EXA_QUERY_LIMIT=3
# AI_UPDATES_SINGLE_SEARXNG_QUERY_LIMIT=5
# AI_UPDATES_SINGLE_RESULTS_PER_QUERY=4
# AI_UPDATES_SINGLE_EXA_RESULTS_PER_QUERY=4
# AI_UPDATES_SINGLE_TIMEOUT=10

# Supporting courses and movies.
# AI_UPDATES_REFRESH_SUPPORTING_CONTENT=1
# AI_UPDATES_SUPPORTING_CONTENT_PREFETCH=1
# AI_UPDATES_SUPPORTING_COURSE_FETCH_POOL=10
# AI_UPDATES_SUPPORTING_MOVIE_FETCH_POOL=40
# AI_UPDATES_COURSE_QUERY=new AI course launched 2026 beginners creators
# AI_UPDATES_COURSE_QUERY_VARIANTS=beginner AI course launched 2026 creators employees|intermediate AI course launched 2026 practical creators
# AI_UPDATES_COURSE_START_PUBLISHED_DATE=2026-01-01
# AI_UPDATES_COURSE_NUM_RESULTS=10
# AI_UPDATES_COURSE_EXA_TYPE=neural
# AI_UPDATES_COURSE_EXA_QUERY_LIMIT=4
# AI_UPDATES_COURSE_EXA_RESULTS_PER_QUERY=10

# Single-version PDF export quality controls.
# Keeps the PDF page dimensions stable while increasing screenshot sharpness.
# PDF_EXPORT_WHATSAPP_RASTER_SCALE=2.0
# PDF_EXPORT_WHATSAPP_JPEG_QUALITY=95
# PDF_EXPORT_WHATSAPP_MAX_MB=10

# Model and semantic memory.
# AI_UPDATES_OPENAI_MODEL=gpt-5.2
# AI_UPDATES_MEMORY_ENABLED=1
# AI_UPDATES_SEMANTIC_MEMORY_ENABLED=1
# AI_UPDATES_SEMANTIC_MAX_CHECK=32
# AI_UPDATES_SINGLE_SEMANTIC_MAX_CHECK=24
# AI_UPDATES_MEMORY_EXACT_LIMIT=3000
# AI_UPDATES_EMBED_MODEL=text-embedding-3-small
# AI_UPDATES_EMBED_INPUT_LIMIT=1200
# AI_UPDATES_EMBED_SIZE=1536
# AI_UPDATES_QDRANT_COLLECTION=content_memory
# AI_UPDATES_SEMANTIC_DUPLICATE_SCORE=0.925
# AI_UPDATES_REJECTED_DUPLICATE_SCORE=0.89

# Background daemon is off by default. The UI Generate button runs manually.
# AI_UPDATES_DAEMON_ENABLED=0
# AI_UPDATES_INTERVAL=3600
