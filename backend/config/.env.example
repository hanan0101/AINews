# AINewsletter_v0.1 environment template
# تترجم هذه الملاحظة معنى التعليق الإنجليزي السابق.
# Copy this file to backend/.env and add real API keys there.
# تترجم هذه الملاحظة معنى التعليق الإنجليزي السابق.
# Never commit backend/.env or any real secret.
# تترجم هذه الملاحظة معنى التعليق الإنجليزي السابق.
# Rules:
# تترجم هذه الملاحظة معنى التعليق الإنجليزي السابق.
# - Uncomment an optional variable to override its Python default.
# تترجم هذه الملاحظة معنى التعليق الإنجليزي السابق.
# - Restart the backend or Docker container after changing a value.
# تترجم هذه الملاحظة معنى التعليق الإنجليزي السابق.
# - Boolean values accept 1/0 or true/false.
# تترجم هذه الملاحظة معنى التعليق الإنجليزي السابق.
# - Docker Compose already overrides service URLs and persistent-data paths.
# تترجم هذه الملاحظة معنى التعليق الإنجليزي السابق.

# -----------------------------------------------------------------------------
# Required and optional API keys
# تترجم هذه الملاحظة معنى التعليق الإنجليزي السابق.

# Required for semantic embeddings when AI_UPDATES_EMBED_MODEL is text-embedding-3-small.
# تترجم هذه الملاحظة معنى التعليق الإنجليزي السابق.
OPENAI_API_KEY=  # Editable here; read by server.py and ai_update_pipeline/config.py. No default.

# Optional Gemini key. When set, Gemini is used for news selection, Arabic writing,
# تترجم هذه الملاحظة معنى التعليق الإنجليزي السابق.
# card rewriting, and AI tool discovery. OPENAI_API_KEY is still used for embeddings.
# تترجم هذه الملاحظة معنى التعليق الإنجليزي السابق.
GEMINI_API_KEY=  # Also accepts Gemini_API_Key for compatibility.

# Required for live Exa news and course discovery.
# تترجم هذه الملاحظة معنى التعليق الإنجليزي السابق.
EXA_API_KEY=  # Editable here; read by ai_update_pipeline/config.py. No default.

# Optional; required only for AI-related movie discovery through TMDb.
# تترجم هذه الملاحظة معنى التعليق الإنجليزي السابق.
TMDB_API_KEY=  # Editable here; read by ai_update_pipeline/config.py. No default.

# -----------------------------------------------------------------------------
# Core server and UI behavior
# تترجم هذه الملاحظة معنى التعليق الإنجليزي السابق.

# Docker Compose overrides HOST to 0.0.0.0. Local Python defaults to 127.0.0.1.
# تترجم هذه الملاحظة معنى التعليق الإنجليزي السابق.
# HOST=127.0.0.1  # Editable here; read by server.py. Docker Compose overrides it.
# تترجم هذه الملاحظة معنى التعليق الإنجليزي السابق.

# Keep 0 for normal live generation. Set 1 to serve only the current news JSON.
# يحافظ هذا السطر على السلوك المذكور في التعليق الإنجليزي.
NEWS_JSON_ONLY_MODE=0  # Editable here; read by server.py.

# Hidden replacement cards retained by the server; 8 keeps 12 total news cards with the 4-card view.
# تترجم هذه الملاحظة معنى التعليق الإنجليزي السابق.
NEWS_BACKUP_COUNT=8  # Editable here; read by server_store.py.

# Preserve a news_previous.json snapshot when saving new content.
# تترجم هذه الملاحظة معنى التعليق الإنجليزي السابق.
# NEWS_PREVIOUS_SNAPSHOT_ENABLED=0  # Editable here; read by server_store.py.
# تترجم هذه الملاحظة معنى التعليق الإنجليزي السابق.

# Visible-news diversity limits.
# تترجم هذه الملاحظة معنى التعليق الإنجليزي السابق.
# NEWS_VISIBLE_MAX_PER_TOPIC_FAMILY=1  # Editable here; read by server_items.py.
# تترجم هذه الملاحظة معنى التعليق الإنجليزي السابق.
# NEWS_VISIBLE_MAX_PER_COMPANY=2  # Editable here; read by server_items.py.
# تترجم هذه الملاحظة معنى التعليق الإنجليزي السابق.

# Generator timing and route controls.
# تترجم هذه الملاحظة معنى التعليق الإنجليزي السابق.
# GENERATOR_TIMEOUT=600  # Editable here; read by server.py.
# تترجم هذه الملاحظة معنى التعليق الإنجليزي السابق.
# AUTO_FETCH_COOLDOWN=300  # Editable here; read by server.py.
# تترجم هذه الملاحظة معنى التعليق الإنجليزي السابق.
# USE_AI_UPDATES_PIPELINE_FOR_GENERATE=1  # Editable here; read by server.py.
# تترجم هذه الملاحظة معنى التعليق الإنجليزي السابق.
# SERVER_TRACE_HTTP=1  # Editable here; read by server.py.
# تترجم هذه الملاحظة معنى التعليق الإنجليزي السابق.

# -----------------------------------------------------------------------------
# Single-card replacement
# تترجم هذه الملاحظة معنى التعليق الإنجليزي السابق.

# Target time in seconds. The Python default is 45; this project uses 90.
# تترجم هذه الملاحظة معنى التعليق الإنجليزي السابق.
SINGLE_REFILL_SECONDS=90  # Editable here; read by server_refill.py.

# Supporting-card candidate target and optional fast mode.
# تترجم هذه الملاحظة معنى التعليق الإنجليزي السابق.
# SINGLE_REFILL_SUPPORTING_TARGET=2  # Editable here; read by server_refill.py.
# تترجم هذه الملاحظة معنى التعليق الإنجليزي السابق.
# SINGLE_REFILL_FAST_MODE=0  # Editable here; read by server_refill.py.
# تترجم هذه الملاحظة معنى التعليق الإنجليزي السابق.
# USE_AI_UPDATES_PIPELINE_FOR_SINGLE_REFILL=1  # Editable here; read by server_refill.py.
# تترجم هذه الملاحظة معنى التعليق الإنجليزي السابق.

# -----------------------------------------------------------------------------
# OpenAI models and output shape
# تترجم هذه الملاحظة معنى التعليق الإنجليزي السابق.

# Optional OpenAI model kept for legacy/manual paths; normal generation is Gemini-only.
# تترجم هذه الملاحظة معنى التعليق الإنجليزي السابق.
AI_UPDATES_OPENAI_MODEL=gpt-5.2  # Editable here; default is defined in ai_update_pipeline/config.py.

# Gemini-only generation should use Flash models that are available on free tier.
# تترجم هذه الملاحظة معنى التعليق الإنجليزي السابق.
AI_UPDATES_MODEL_PROVIDER=gemini
GEMINI_NEWS_MODEL=gemini-2.5-flash
GEMINI_REWRITE_MODEL=gemini-2.5-flash
GEMINI_FLASH_MODEL=gemini-2.5-flash
GEMINI_DAILY_REQUEST_BUDGET=18
GEMINI_FULL_RUN_REQUEST_BUDGET=6
GEMINI_MIN_SECONDS_BETWEEN_CALLS=6
GEMINI_STOP_ON_QUOTA=1

# Lightweight OpenAI rewrite fallback used only when GEMINI_API_KEY is not set.
# تترجم هذه الملاحظة معنى التعليق الإنجليزي السابق.
# OPENAI_REWRITE_MODEL=gpt-4o-mini  # Editable here; read by server.py.
# تترجم هذه الملاحظة معنى التعليق الإنجليزي السابق.

# Current level-balanced UI displays 4 news cards, 2 courses, and 1 movie.
# تترجم هذه الملاحظة معنى التعليق الإنجليزي السابق.
