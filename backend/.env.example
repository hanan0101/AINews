# Active environment for AINewsletter_v0.1.
# Copy this file to backend/.env, then fill in the real key values.
# Never commit real API keys.

# Required for GPT selection, Arabic rewriting, and semantic-memory embeddings.
OPENAI_API_KEY=

# Required for live AI news and course discovery.
EXA_API_KEY=

# Optional. Required only if the supporting AI-related movie card is enabled.
TMDB_API_KEY=

# Single-card refill target time in seconds.
SINGLE_REFILL_SECONDS=90

# Keep 0 for normal UI Generate. Set 1 only when you want to block live generation.
NEWS_JSON_ONLY_MODE=0

# Hidden replacement pool size for news cards.
NEWS_BACKUP_COUNT=6

# Optional local SearXNG endpoint. The code defaults to http://localhost:8080.
# AI_UPDATES_SEARXNG_URL=http://localhost:8080

# Optional output counts. Current UI expects 6 news, 2 courses, and 1 movie.
# AI_UPDATES_VISIBLE_COUNT=6
# AI_UPDATES_COURSES_VISIBLE_COUNT=2
# AI_UPDATES_MOVIES_VISIBLE_COUNT=1

# Optional model/cost controls.
# AI_UPDATES_OPENAI_MODEL=gpt-5.2
# AI_UPDATES_SCAN_POOL_LIMIT=120
# AI_UPDATES_GPT_SHORTLIST_LIMIT=60
# AI_UPDATES_GPT_COMPACT_LIMIT=60

# Optional monthly tool-cache maintenance.
# AI_UPDATES_TOOL_CACHE_REFRESH_DAYS=30
# AI_UPDATES_TOOL_CACHE_MAX_RECORDS=120
# AI_UPDATES_TOOL_DISCOVERY_ENABLED=1
# AI_UPDATES_TOOL_DISCOVERY_MODEL=gpt-4o-mini
# AI_UPDATES_TOOL_DISCOVERY_RESULTS=6

# Optional semantic-memory controls. Qdrant uses cosine similarity locally.
# AI_UPDATES_MEMORY_ENABLED=1
# AI_UPDATES_SEMANTIC_MEMORY_ENABLED=1
# AI_UPDATES_EMBED_MODEL=text-embedding-3-small

# Optional course fetch controls. Courses are restricted to the configured course domains.
# AI_UPDATES_COURSE_QUERY=new AI course launched 2026 beginners creators
# AI_UPDATES_COURSE_QUERY_VARIANTS=beginner AI course launched 2026 creators employees|intermediate AI course launched 2026 practical creators
# AI_UPDATES_COURSE_START_PUBLISHED_DATE=2026-01-01
# AI_UPDATES_COURSE_NUM_RESULTS=10
# AI_UPDATES_COURSE_EXA_QUERY_LIMIT=4

# Optional single-version PDF export quality controls.
# Keeps the PDF page dimensions stable while increasing screenshot sharpness.
# PDF_EXPORT_WHATSAPP_RASTER_SCALE=2.0
# PDF_EXPORT_WHATSAPP_JPEG_QUALITY=95
# PDF_EXPORT_WHATSAPP_MAX_MB=10
