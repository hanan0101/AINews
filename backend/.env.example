# AINewsletter_v0.2 environment template
# Copy this file to backend/.env and add real API keys there.
# Never commit backend/.env or any real secret.
# Rules:
# - Uncomment an optional variable to override its Python default.
# - Restart the backend or Docker container after changing a value.
# - Boolean values accept 1/0 or true/false.
# - Docker Compose already overrides service URLs and persistent-data paths.

# -----------------------------------------------------------------------------
# Required and optional API keys

# Optional fallback provider key; not used while AI_UPDATES_MODEL_PROVIDER=gemini.
OPENAI_API_KEY=  # Editable here; read by backend/config/settings.py. No default.

# Gemini key used for news selection, Arabic rewriting, embeddings, and AI tool discovery.
# Use this exact canonical name because the direct Gemini client reads it.
GEMINI_API_KEY=

# Required for live Exa news and course discovery.
EXA_API_KEY=  # Editable here; read by backend/config/settings.py. No default.

# Optional; required only for AI-related movie discovery through TMDb.
TMDB_API_KEY=  # Editable here; read by backend/config/settings.py. No default.

# -----------------------------------------------------------------------------
# Core server and UI behavior

# Docker Compose overrides HOST to 0.0.0.0. Local Python defaults to 127.0.0.1.
# HOST=127.0.0.1  # Editable here; read by backend/server/http_server.py. Docker Compose overrides it.

# Keep 0 for normal live generation. Set 1 to serve only the current news JSON.
NEWS_JSON_ONLY_MODE=0  # Editable here; read by backend/server/http_server.py.

# Hidden replacement cards retained by the server. The checked profile keeps
# 18 total cards: 4 visible + 14 replacement/bank cards.
NEWS_BACKUP_COUNT=14  # Keep aligned with AI_UPDATES_BACKUP_COUNT.

# Preserve a news_previous.json snapshot when saving new content.
# NEWS_PREVIOUS_SNAPSHOT_ENABLED=0  # Editable here; read by backend/storage/newsletter_store.py.

# Visible-news diversity limits.
# NEWS_VISIBLE_MAX_PER_TOPIC_FAMILY=1  # Editable here; read by backend/server/card_items.py.
# NEWS_VISIBLE_MAX_PER_COMPANY=2  # Editable here; read by backend/server/card_items.py.

# Generator timing and route controls.
# GENERATOR_TIMEOUT=600  # Editable here; read by backend/server/http_server.py.
# AUTO_FETCH_COOLDOWN=300  # Editable here; read by backend/server/http_server.py.
# USE_AI_UPDATES_PIPELINE_FOR_GENERATE=1  # Editable here; read by backend/server/http_server.py.
# SERVER_TRACE_HTTP=1  # Editable here; read by backend/server/http_server.py.
# Availability controls: reject an oversized JSON request body without
# reading it, and close a connection that stalls mid-request.
# MAX_JSON_BODY_BYTES=2097152  # 2MB. Editable here; read by backend/server/http_server.py.
# HTTP_REQUEST_READ_TIMEOUT_SECONDS=30  # Editable here; read by backend/server/http_server.py.
# Cost control: full generate/refresh runs allowed per rolling 24h, across
# every admin and every trigger (manual Generate, missing-section refill).
# Single-card refill/replace is not counted. Read by backend/server/generator_bridge.py.
# AI_UPDATES_MAX_GENERATE_RUNS_PER_DAY=8

# -----------------------------------------------------------------------------
# Single-card replacement

# Target time in seconds. The Python default is 45; this project uses 90.
SINGLE_REFILL_SECONDS=90  # Editable here; read by backend/server/single_card_refill.py.

# Supporting-card candidate target and optional fast mode.
# SINGLE_REFILL_SUPPORTING_TARGET=2  # Editable here; read by backend/server/single_card_refill.py.
# SINGLE_REFILL_FAST_MODE=0  # Editable here; read by backend/server/single_card_refill.py.
# USE_AI_UPDATES_PIPELINE_FOR_SINGLE_REFILL=1  # Editable here; read by backend/server/single_card_refill.py.

# -----------------------------------------------------------------------------
# OpenAI models and output shape

# Optional OpenAI model kept for legacy/manual paths; normal generation is Gemini-only.
AI_UPDATES_OPENAI_MODEL=gpt-5.2  # Editable here; default is defined in backend/config/settings.py.

# Gemini role defaults. A deployment may override each role independently.
AI_UPDATES_MODEL_PROVIDER=gemini
GEMINI_SELECTION_MODEL=gemini-3.5-flash
GEMINI_REWRITE_MODEL=gemini-3.1-pro-preview
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_FLASH_MODEL=gemini-3.5-flash
GEMINI_DAILY_REQUEST_BUDGET=120
GEMINI_FULL_RUN_REQUEST_BUDGET=0
GEMINI_MIN_SECONDS_BETWEEN_CALLS=6
# Actually halt the pipeline once GEMINI_DAILY_REQUEST_BUDGET is hit, instead
# of continuing to call Gemini past the configured soft budget.
GEMINI_STOP_ON_QUOTA=1
# Per-request HTTP timeout (seconds) for every Gemini call. Without this, a
# stalled connection hangs forever and holds the Generate lock indefinitely.
GEMINI_REQUEST_TIMEOUT_SECONDS=120

# Lightweight OpenAI rewrite fallback used only when GEMINI_API_KEY is not set.
# OPENAI_REWRITE_MODEL=gpt-4o-mini  # Editable here; read by backend/server/http_server.py.

# Current level-balanced UI displays 4 news cards. The generation profile
# creates 18 news cards: 4 visible + 14 backup/bank cards.
AI_UPDATES_VISIBLE_COUNT=4
AI_UPDATES_BACKUP_COUNT=14  # Keep aligned with NEWS_BACKUP_COUNT.
# AI_UPDATES_COURSES_VISIBLE_COUNT=6  # Editable here; default is defined in backend/config/settings.py.
# AI_UPDATES_MOVIES_VISIBLE_COUNT=2  # Editable here; default is defined in backend/config/settings.py.
# AI_UPDATES_SAVE_BACKUP_FROM_SELECTION=1  # Editable here; default is defined in backend/config/settings.py.

# Final selection limits.
# News freshness window: default is 7 days / last week. Uncomment to override it.
# AI_UPDATES_LOOKBACK_DAYS=7  # Editable here; default is defined in backend/config/settings.py.
AI_UPDATES_OUTPUT_LIMIT=18
AI_UPDATES_MIN_NEWS_SAVE_COUNT=12  # Minimum accepted save; complete target remains 18.
# AI_UPDATES_SINGLE_OUTPUT_LIMIT=5  # Editable here; default is defined in backend/config/settings.py.
# AI_UPDATES_SCAN_POOL_LIMIT=120  # Editable here; default is defined in backend/config/settings.py.
AI_UPDATES_GPT_SHORTLIST_LIMIT=72
AI_UPDATES_GPT_COMPACT_LIMIT=72
# AI_UPDATES_SINGLE_GPT_COMPACT_LIMIT=36  # Editable here; default is defined in backend/config/settings.py.

# Write news.json when running the pipeline directly rather than through server.py.
# AI_UPDATES_WRITE_NEWS_JSON=0  # Editable here; read by backend/pipeline/orchestrator.py.

# -----------------------------------------------------------------------------
# SearXNG search

# SearXNG is required. Docker Compose sets this to http://searxng:8080.
# Uncomment only when the backend runs locally outside Docker.
# AI_UPDATES_SEARXNG_URL=http://localhost:8080  # Editable here; read by backend/config/settings.py. Docker overrides it.

# Legacy aliases accepted by config.py; prefer AI_UPDATES_SEARXNG_URL.
# SEARXNG_URL=http://localhost:8080  # Editable here; legacy alias read by backend/config/settings.py.
# SEARXNG_BASE_URL=http://localhost:8080  # Editable here; legacy alias read by backend/config/settings.py.

# Full-generation SearXNG limits.
# AI_UPDATES_SEARXNG_QUERY_LIMIT=40  # Editable here; default is defined in backend/config/settings.py.
# AI_UPDATES_SEARXNG_RESULTS_PER_QUERY=8  # Editable here; default is defined in backend/config/settings.py.
AI_UPDATES_SEARXNG_TIMEOUT=16
# AI_UPDATES_SEARXNG_MAX_WORKERS=3  # Editable here; default is defined in backend/config/settings.py.
# SearXNG source freshness: default is week so search aligns with the 7-day news window.
# AI_UPDATES_SEARXNG_TIME_RANGE=week  # Editable here; default is defined in backend/config/settings.py.
# AI_UPDATES_SEARXNG_CATEGORIES=news,it,general  # Editable here; default is defined in backend/config/settings.py.

# Enable the broader general-news query lane used by the checked runtime.
AI_UPDATES_GENERAL_NEWS_LAYER_ENABLED=1

# -----------------------------------------------------------------------------
# Exa search

# Full-generation Exa limits and retry behavior.
# AI_UPDATES_EXA_QUERY_LIMIT=28  # Editable here; default is defined in backend/config/settings.py.
# AI_UPDATES_EXA_RESULTS_PER_QUERY=5  # Editable here; default is defined in backend/config/settings.py.
# AI_UPDATES_EXA_TIMEOUT=15  # Editable here; default is defined in backend/config/settings.py.
# AI_UPDATES_EXA_MAX_WORKERS=6  # Editable here; default is defined in backend/config/settings.py.
# AI_UPDATES_EXA_RETRIES=2  # Editable here; default is defined in backend/config/settings.py.
# AI_UPDATES_EXA_RETRY_BACKOFF_SECONDS=2  # Editable here; default is defined in backend/config/settings.py.

# Single-card search limits shared across Exa and SearXNG.
# AI_UPDATES_SINGLE_EXA_QUERY_LIMIT=6  # Editable here; default is defined in backend/config/settings.py.
# AI_UPDATES_SINGLE_SEARXNG_QUERY_LIMIT=10  # Editable here; default is defined in backend/config/settings.py.
# AI_UPDATES_SINGLE_RESULTS_PER_QUERY=5  # Editable here; default is defined in backend/config/settings.py.
# AI_UPDATES_SINGLE_EXA_RESULTS_PER_QUERY=5  # Editable here; default is defined in backend/config/settings.py.
# AI_UPDATES_SINGLE_TIMEOUT=16  # Editable here; default is defined in backend/config/settings.py.

# -----------------------------------------------------------------------------
# Monthly AI-tool discovery and cache maintenance

# AI_UPDATES_TOOL_CACHE_REFRESH_DAYS=30  # Editable here; default is defined in backend/config/settings.py.
# AI_UPDATES_TOOL_CACHE_MAX_RECORDS=120  # Editable here; default is defined in backend/config/settings.py.
# AI_UPDATES_TOOL_DISCOVERY_ENABLED=1  # Editable here; default is defined in backend/config/settings.py.
# AI_UPDATES_TOOL_DISCOVERY_MODEL=gpt-4o-mini  # OpenAI fallback only when GEMINI_API_KEY is not set.
# AI_UPDATES_TOOL_DISCOVERY_RESULTS=6  # Editable here; default is defined in backend/config/settings.py.
# AI_UPDATES_TOOL_SITE_DISCOVERY_LIMIT=24  # Editable here; read by backend/pipeline/fetching/.
# AI_UPDATES_TOOL_QUERY_ROTATION_POOL=48  # Editable here; read by backend/pipeline/fetching/.

# -----------------------------------------------------------------------------
# Courses and movies

# Supporting-content controls.
# AI_UPDATES_REFRESH_SUPPORTING_CONTENT=1  # Editable here; default is defined in backend/config/settings.py.
# AI_UPDATES_SUPPORTING_CONTENT_PREFETCH=1  # Editable here; default is defined in backend/config/settings.py.
# AI_UPDATES_SUPPORTING_COURSE_FETCH_POOL=24  # Editable here; default is defined in backend/config/settings.py.
# AI_UPDATES_SUPPORTING_MOVIE_FETCH_POOL=40  # Editable here; default is defined in backend/config/settings.py.
# AI_UPDATES_SINGLE_COURSE_FETCH_POOL=14  # Editable here; read by backend/pipeline/orchestrator.py.
# AI_UPDATES_SINGLE_MOVIE_FETCH_POOL=28  # Editable here; read by backend/pipeline/orchestrator.py.

# Leave the course query unset to use the maintained query bank in config.py.
# If overriding the date, use YYYY-MM-DD. When unset, code uses January 1 of
# the current year automatically; no annual edit is required.
# AI_UPDATES_COURSE_QUERY=  # Editable here; read by backend/config/settings.py.
# AI_UPDATES_COURSE_QUERY_VARIANTS=  # Editable here; read by backend/config/settings.py.
# AI_UPDATES_COURSE_START_PUBLISHED_DATE=YYYY-MM-DD  # Editable here; dynamic default is defined in backend/config/settings.py.
# AI_UPDATES_COURSE_NUM_RESULTS=10  # Editable here; default is defined in backend/config/settings.py.
# AI_UPDATES_COURSE_EXA_TYPE=neural  # Editable here; default is defined in backend/config/settings.py.
# AI_UPDATES_COURSE_EXA_QUERY_LIMIT=6  # Editable here; default is defined in backend/config/settings.py.
# AI_UPDATES_COURSE_EXA_RESULTS_PER_QUERY=10  # Editable here; default is defined in backend/config/settings.py.

# Rotate TMDb discovery pages to avoid returning the same movies every run.
# AI_UPDATES_MOVIE_ROTATION_MAX_PAGE=6  # Editable here; read by backend/pipeline/fetching/.

# -----------------------------------------------------------------------------
# Qdrant semantic memory and duplicate detection

# AI_UPDATES_MEMORY_ENABLED=1  # Editable here; default is defined in backend/config/settings.py.
# AI_UPDATES_SEMANTIC_MEMORY_ENABLED=1  # Editable here; default is defined in backend/config/settings.py.
# AI_UPDATES_SEMANTIC_MAX_CHECK=32  # Editable here; default is defined in backend/config/settings.py.
# AI_UPDATES_SINGLE_SEMANTIC_MAX_CHECK=24  # Editable here; default is defined in backend/config/settings.py.
# AI_UPDATES_MEMORY_EXACT_LIMIT=3000  # Editable here; default is defined in backend/config/settings.py.
# AI_UPDATES_EMBED_MODEL=text-embedding-3-small  # Editable here; default is defined in backend/config/settings.py.
# AI_UPDATES_EMBED_INPUT_LIMIT=1200  # Editable here; default is defined in backend/config/settings.py.
# AI_UPDATES_EMBED_SIZE=1536  # Editable here; default is defined in backend/config/settings.py.
# AI_UPDATES_QDRANT_COLLECTION=content_memory  # Editable here; default is defined in backend/config/settings.py.
AI_UPDATES_SEMANTIC_DUPLICATE_SCORE=0.90
# AI_UPDATES_SAME_RUN_SEMANTIC_SCORE=0.90  # Editable here; default is defined in backend/config/settings.py.
# AI_UPDATES_REJECTED_DUPLICATE_SCORE=0.89  # Editable here; default is defined in backend/config/settings.py.

# -----------------------------------------------------------------------------
# Structured run logging and diagnostics

# Set AI_UPDATES_RUN_LOG_ENABLED=0 to stop creating ai_updates_run.jsonl.
# AI_UPDATES_RUN_LOG_ENABLED=1  # Editable here; read by backend/logging/pipeline_logging.py.
# AI_UPDATES_RUN_LOG_STDOUT=1  # Editable here; read by backend/logging/pipeline_logging.py.
# AI_UPDATES_RUN_LOG_FILE=backend/logs/ai_updates_run.jsonl  # Editable here; read by backend/logging/pipeline_logging.py.

# Docker Compose stores the run report under /app/data/news/diagnostics.
# AI_UPDATES_RUN_REPORT_PATH=  # Editable here; read by backend/server/http_server.py and backend/config/settings.py. Docker overrides it.
# MODEL_USAGE_SUMMARY_PATH=  # Operational model/quota state; Docker stores it under /app/data/news/runtime.

# -----------------------------------------------------------------------------
# Background generation daemon

# Disabled by default; the UI Generate button runs the pipeline manually.
# AI_UPDATES_DAEMON_ENABLED=0  # Editable here; default is defined in backend/config/settings.py.
# AI_UPDATES_INTERVAL=3600  # Editable here; default is defined in backend/config/settings.py.

# -----------------------------------------------------------------------------
# PDF export and PDF import

# PDF export profile and optional rendering controls.
# PDF_EXPORT_PROFILE=whatsapp  # Editable here; read by backend/utils/pdf_export_service.py.
# PDF_EXPORT_SCALE=  # Editable here; read by backend/utils/pdf_export_service.py.
# PDF_EXPORT_WHATSAPP_RASTER_SCALE=2.0  # Editable here; read by backend/utils/pdf_export_service.py.
# PDF_EXPORT_WHATSAPP_SCALE=2.0  # Editable here; legacy alias read by backend/utils/pdf_export_service.py.
# PDF_EXPORT_WHATSAPP_JPEG_QUALITY=95  # Editable here; read by backend/utils/pdf_export_service.py.
# PDF_EXPORT_WHATSAPP_MAX_MB=10  # Editable here; read by backend/utils/pdf_export_service.py.
# Force-close a stuck export's Chromium process after this many seconds.
# PDF_EXPORT_HARD_TIMEOUT_SECONDS=90  # Editable here; read by backend/utils/pdf_export_service.py.
# How many PDF/PPTX exports (each launches Chromium) may run at once,
# server-wide. Read by backend/server/http_server.py.
# PDF_EXPORT_MAX_CONCURRENT=1
# Per-user PDF/PPTX export requests allowed per rolling 60 seconds.
# PDF_EXPORT_RATE_LIMIT_PER_MINUTE=6

# Local defaults are backend/logs and backend/pdf_versions.
# PDF_IMPORT_DEBUG_DIR=  # Editable here; read by backend/storage/manage_versions/version_routes.py.
# PDF_VERSION_FILES_DIR=  # Editable here; read by backend/storage/manage_versions/version_routes.py.

# -----------------------------------------------------------------------------
# Keycloak authentication and PostgreSQL
# See backend/config/ENVIRONMENT_GUIDE.md for the full explanation of each one.

# Docker Compose sets these to the in-network service hostnames. Only needed
# here when running the backend outside Docker (see docs/SETUP.md).
# KEYCLOAK_SERVER_URL=http://localhost:8180/  # Editable here; read by backend/auth/authentication.py. Docker overrides it.
# KEYCLOAK_REALM=newsletter  # Editable here; read by backend/auth/authentication.py. Must match the value hardcoded in docker/compose/app.yml.
# KEYCLOAK_CLIENT_ID=newsletter-app  # Editable here; read by backend/auth/authentication.py. Must match the value hardcoded in docker/compose/app.yml.
# KEYCLOAK_CLIENT_SECRET=  # Editable here; read by backend/auth/authentication.py. No default on purpose - auto-generated into backend/.env.local on first run if unset, same as LOCAL_VIEWER_PASSWORD below. bootstrap provisions/re-syncs the Keycloak client with whatever this resolves to, on every startup.

# One-time Keycloak provisioning (backend/auth/keycloak_bootstrap.py), runs
# automatically on every app startup and is a no-op once the realm exists.
#
# LOCAL_VIEWER_PASSWORD, KEYCLOAK_BOOTSTRAP_ADMIN_PASSWORD, KEYCLOAK_ADMIN_PASSWORD,
# and KEYCLOAK_BOOTSTRAP_USER_PASSWORD have NO default here on purpose - a
# fixed password shipped in this file would just become the next hardcoded
# default. If you don't set one yourself, it is generated once and saved to
# the untracked backend/.env.local on first run (see backend/auth/authentication.py).
# Before your first `docker compose up`, run this once so the Keycloak
# container's admin password exists before it starts:
#   python -m scripts.ensure_local_secrets
# Set any of these here instead if you want a specific value of your own -
# whatever you set always wins over the auto-generated one.
# KEYCLOAK_ADMIN_URL=  # Editable here; defaults to KEYCLOAK_SERVER_URL.
# KEYCLOAK_BOOTSTRAP_ADMIN_USER=admin  # Editable here; must match KEYCLOAK_ADMIN in docker/compose/keycloak.yml.
# KEYCLOAK_BOOTSTRAP_ADMIN_PASSWORD=  # Editable here; must match KEYCLOAK_ADMIN_PASSWORD, which only backend/.env.local shares with the Keycloak container (see docker/compose/keycloak.yml).
# KEYCLOAK_BOOTSTRAP_USER=admin  # Editable here; the one app-admin account bootstrap creates.
# KEYCLOAK_BOOTSTRAP_USER_PASSWORD=  # Editable here.
# KEYCLOAK_BOOTSTRAP_WAIT_SECONDS=60  # Editable here; how long to poll Keycloak before giving up on bootstrap this startup.
# Long-lived login. Default is 31536000 seconds (about one year), so the app
# keeps the user signed in until logout/browser cleanup/secret rotation.
# AUTH_SESSION_MAX_AGE_SECONDS=31536000  # Editable here; cookie lifetime.
# KEYCLOAK_ACCESS_TOKEN_LIFESPAN_SECONDS=31536000  # Editable here; applied on every startup, not just first bootstrap.
# KEYCLOAK_SSO_SESSION_IDLE_TIMEOUT_SECONDS=31536000  # Editable here; Keycloak idle session lifetime.
# KEYCLOAK_SSO_SESSION_MAX_LIFESPAN_SECONDS=31536000  # Editable here; Keycloak absolute session lifetime.

# Session cookies and the non-Keycloak, view-only fallback login.
# AUTH_COOKIE_NAME=  # Editable here; read by backend/auth/authentication.py.
# AUTH_REFRESH_COOKIE_NAME=  # Editable here; read by backend/auth/authentication.py.
# AUTH_COOKIE_SECURE=0  # Editable here; set to 1 once the server is behind HTTPS.
# LOCAL_VIEWER_AUTH_ENABLED=1  # Editable here; read by backend/auth/authentication.py.
# LOCAL_VIEWER_USERNAME=news  # Editable here; read by backend/auth/authentication.py.
# LOCAL_VIEWER_PASSWORD=  # Editable here; no default - auto-generated into backend/.env.local on first run if unset. See the Keycloak provisioning note above.
# LOCAL_AUTH_SECRET=  # Editable here; signing secret for locally-issued session tokens. Same auto-generation as LOCAL_VIEWER_PASSWORD.
# LOCAL_VIEWER_TOKEN_TTL_SECONDS=31536000  # Editable here; defaults to AUTH_SESSION_MAX_AGE_SECONDS.

# PostgreSQL — stores newsletter versions and the course catalog.
# POSTGRES_HOST=localhost  # Editable here; read by backend/storage/manage_versions/version_routes.py and course_repository.py. Docker overrides it.
# POSTGRES_PORT=5432  # Editable here; same readers as above.
# POSTGRES_DB=ainewsletter  # Editable here; same readers as above.
# POSTGRES_USER=ainewsletter  # Editable here; same readers as above.
POSTGRES_PASSWORD=ainewsletter_local  # Editable here; same readers as above. Change this for anything beyond local dev.

# -----------------------------------------------------------------------------
# Version database, backups, and generated JSON paths

# Newsletter runtime data defaults to data/news/runtime and diagnostic reports
# default to data/news/diagnostics. Docker Compose uses the same separation.
# VERSIONS_DB_PATH=  # Editable here; read by backend/storage/manage_versions/version_routes.py. Docker overrides it.
# VERSIONS_BACKUP_DIR=  # Editable here; read by backend/storage/manage_versions/version_routes.py. Docker overrides it.
# NEWS_JSON_PATH=  # Editable here; read by backend/storage/newsletter_store.py and backend/config/settings.py. Docker overrides it.
# PREVIOUS_NEWS_JSON_PATH=  # Editable here; read by backend/storage/newsletter_store.py. Docker overrides it.
